    "test:rules": "firebase emulators:exec --project demo-library-work-log-rules --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=18"
  }
}
