# Firebase コンソール > プロジェクトの設定 > マイアプリ から取得
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ローカルでFirebase Emulator Suiteを利用する場合のみ true
VITE_USE_FIREBASE_EMULATORS=false

# 任意: レポートのLLM要約を生成するプロバイダ非依存HTTPエンドポイント
VITE_REPORT_SUMMARIZER_ENDPOINT=
# 任意: エンドポイント側で使用する内部モデル識別子（UIには表示しません）
VITE_REPORT_SUMMARIZER_MODEL=
